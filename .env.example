# Panto environment variables — copy to .env (local) or add in Vercel dashboard.
# NEVER commit your real .env file.

# ── Server-side LLM (never prefixed, never in the browser) ───────────────────
# Primary brain: Groq (free tier) — fast inference, great for routing + chat.
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Fallback brain: xAI (optional). Used if GROQ_API_KEY is absent.
# Get key: https://console.x.ai
XAI_API_KEY=

# Model override (auto-selected per provider — only set if you want a specific model)
# Groq default: openai/gpt-oss-120b   xAI default: grok-4-fast
LLM_MODEL=

# Full endpoint override (rarely needed)
LLM_API_BASE=

# ── Door 1 — Discovery: platform-scoped social search ────────────────────────
# Exa semantic search — scoped to instagram.com, tiktok.com, linkedin.com, twitter.com
# Groq routes the query to the right platforms first, Exa finds profiles/posts.
# Get key: https://exa.ai (free tier available)
EXA_API_KEY=

# Override Exa base URL (rarely needed)
EXA_API_BASE=

# ── Door 2 — Compliance: social footprint verification ───────────────────────
# qeeqbox/social-analyzer is bundled via npm — NO extra key needed.
# It checks usernames across 1000+ platforms using HTTP fast-scan.
# No config required here — just works once npm install runs.

# ── Client-side (VITE_ prefix — safe to expose in browser) ───────────────────
# Supabase magic-link auth. Leave empty to keep demo auth (auto-fills code).
# Get from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Override the agent endpoint (defaults to same-origin /api/agent)
VITE_AGENT_ENDPOINT=
