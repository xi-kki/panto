# Panto environment variables — copy to .env and fill in.
# NEVER commit your real .env file.

# ── Auth (optional for demo) ─────────────────────────────
# Supabase project (magic-link email auth). Leave empty to use demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Agent brain (backend — add when wiring the agent) ────
# Grok API key for reasoning/drafting (server-side only, never expose in client)
XAI_API_KEY=
# Exa / Tavily for deep search across the open web
EXA_API_KEY=
TAVILY_API_KEY=
# Bright Data MCP credentials for Instagram/TikTok/LinkedIn/X sourcing
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
