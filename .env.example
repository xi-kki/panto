# Panto environment variables — copy to .env (local) or add in Vercel dashboard.
# NEVER commit your real .env file.

# ── Server-side (Vercel env vars — NEVER prefixed, never in the client) ──
# Agent brain: Groq (free tier) first, xAI Grok fallback. Either key works.
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# xAI key (optional fallback): https://console.x.ai
XAI_API_KEY=

# Model override (default: llama-3.3-70b-versatile on Groq, grok-4-fast on xAI).
# If you hit a 404 model_not_found, pick an id from console.groq.com/docs/models
LLM_MODEL=

# Full endpoint override (rarely needed; auto-set per provider)
LLM_API_BASE=

# Exa — Door 1 discovery search (https://exa.ai)
EXA_API_KEY=

# ── Client-side (VITE_ prefix — safe to expose) ──────────────────────────
# Supabase magic-link auth. Leave empty to keep demo auth (auto-filled code).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Override the agent endpoint (defaults to same-origin /api/agent)
VITE_AGENT_ENDPOINT=
